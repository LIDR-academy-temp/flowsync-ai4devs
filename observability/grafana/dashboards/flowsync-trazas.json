{
  "uid": "flowsync-trazas",
  "title": "FlowSync · Trazas",
  "tags": [
    "flowsync",
    "otel",
    "tempo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Trazas de flowsync-api: gráficas con las span-metrics que Tempo genera en Prometheus, tablas con TraceQL sobre Tempo.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GET /api/v1/tasks: solicitudes en el rango",
      "description": "Denominador del SLI de docs/slo/api.md, en el rango de tiempo elegido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_spanmetrics_calls_total{service=\"flowsync-api\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"GET /api/v1/tasks\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GET /api/v1/tasks: < 512 ms (aprox. del SLI de latencia)",
      "description": "APROXIMADO: los cubos de span-metrics van de potencia en potencia de 2 y el más cercano a 500 ms es 512 ms. El cálculo exacto (< 500 ms y HTTP < 500) está en las tablas de abajo, por TraceQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_spanmetrics_latency_bucket{service=\"flowsync-api\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"GET /api/v1/tasks\",le=\"0.512\"}[$__range])) / sum(increase(traces_spanmetrics_latency_count{service=\"flowsync-api\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"GET /api/v1/tasks\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GET /api/v1/tasks: tramos con estado ERROR",
      "description": "La instrumentación HTTP marca ERROR en el tramo servidor cuando la respuesta es 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traces_spanmetrics_calls_total{service=\"flowsync-api\",span_kind=\"SPAN_KIND_SERVER\",span_name=\"GET /api/v1/tasks\",status_code=\"STATUS_CODE_ERROR\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Solicitudes por segundo, por ruta",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"flowsync-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p95 de las rutas",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"flowsync-api\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia p95 de las consultas a la base",
      "description": "Tramos cliente (consultas SQL). Aquí se ve qué consulta pesa más dentro de cada petición.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"flowsync-api\",span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Últimas trazas de flowsync-api",
      "description": "Pulsa un Trace ID para abrir el árbol de tramos.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"flowsync-api\" && kind=server}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "GET /api/v1/tasks lentas (>= 500 ms): rompen el SLO",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"flowsync-api\" && kind=server && span.http.route=\"/api/v1/tasks\" && duration >= 500ms}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Errores de servidor (HTTP >= 500): rompen el SLO",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"flowsync-api\" && kind=server && span.http.response.status_code >= 500}",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
