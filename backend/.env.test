SESSION_DRIVER=memory

# Base de pruebas: servicio `db-test` de compose.yaml, en memoria (tmpfs).
DB_HOST=localhost
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test

# OpenTelemetry. `start/env.ts` no admite `test` en APP_ENV: solo development,
# staging o production. En esta suite el SDK no llega a iniciarse.
APP_NAME=flowsync-api
APP_VERSION=0.0.1
APP_ENV=development
