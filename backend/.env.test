SESSION_DRIVER=memory

# Base de pruebas: servicio `db-test` de compose.yaml, en memoria (tmpfs).
DB_HOST=localhost
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test

# Identidad del servicio en OpenTelemetry. El SDK no arranca en NODE_ENV=test
# (config/otel.ts, `enabled` por defecto), pero start/env.ts exige las tres.
# APP_ENV no admite `test`: solo development, staging o production.
APP_NAME=flowsync-api
APP_VERSION=0.0.1
APP_ENV=development
