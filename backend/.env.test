SESSION_DRIVER=memory

# Base de pruebas: servicio `db-test` de compose.yaml, en memoria (tmpfs).
DB_HOST=localhost
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test

# OpenTelemetry: `start/env.ts` las valida al arrancar. `APP_ENV` es
# `development` porque su validación no admite `test`; con NODE_ENV=test el
# paquete no envía trazas.
APP_NAME=flowsync-api
APP_VERSION=0.0.0
APP_ENV=development
