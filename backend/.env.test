SESSION_DRIVER=memory

# Base de pruebas: servicio `db-test` de compose.yaml, en memoria (tmpfs).
DB_HOST=localhost
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test

#--------------------------------------------------------------------
# OpenTelemetry (@adonisjs/otel). APP_NAME es el service.name de las trazas.
# 4318 es OTLP por HTTP; 4317 es gRPC y aqui no sirve.
#--------------------------------------------------------------------
APP_NAME=flowsync-api
APP_VERSION=0.0.1
APP_ENV=test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
